# Extra protection if the package root is uploaded by mistake.
# Production DocumentRoot must still point to public/.
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:bin|tests|docs|docker|var)(?:/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
</IfModule>
<FilesMatch "\.(md|cjs|sql|sqlite|sqlite3|db|key|log|env|nxb|bak|sha256)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
