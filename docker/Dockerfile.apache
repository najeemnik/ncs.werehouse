# syntax=docker/dockerfile:1
FROM php:8.3-apache-bookworm@sha256:a14446c32a3c8aeb9b4dac7fb73b03dfd8006e670d9b43ea7947e4030d3cbae6
RUN --mount=type=secret,id=proxy_ca,required=true \
    apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca update \
    && apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca install -y --no-install-recommends libfreetype6-dev libjpeg62-turbo-dev libpng-dev libwebp-dev libonig-dev libcurl4-openssl-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j2 pdo_mysql gd mbstring curl \
    && a2enmod rewrite headers \
    && sed -ri 's!/var/www/html!/app/public!g' /etc/apache2/sites-available/000-default.conf \
    && printf '<Directory /app/public>\nAllowOverride All\nRequire all granted\n</Directory>\n' > /etc/apache2/conf-available/nsc.conf \
    && a2enconf nsc \
    && mkdir -p /app/public \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
